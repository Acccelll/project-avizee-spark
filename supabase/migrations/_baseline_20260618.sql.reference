-- 4. RLS policies
tablename	policyname	cmd	qual
app_configuracoes	Admin can insert app_configuracoes	INSERT	
app_configuracoes	Admin can update app_configuracoes	UPDATE	has_role(auth.uid(), 'admin'::app_role)
app_configuracoes	Admins can select app_configuracoes	SELECT	has_role(auth.uid(), 'admin'::app_role)
apresentacao_cadencia	apresentacao_cadencia_delete	DELETE	has_role(auth.uid(), 'admin'::app_role)
apresentacao_cadencia	apresentacao_cadencia_insert	INSERT	
apresentacao_cadencia	apresentacao_cadencia_select	SELECT	(has_role(auth.uid(), 'admin'::app_role) OR (EXISTS ( SELECT 1
   FROM user_permissions up
  WHERE ((up.user_id = auth.uid()) AND (up.resource = 'apresentacao'::text) AND (up.action = ANY (ARRAY['visualizar'::text, 'gerenciar_templates'::text, 'gerar'::text, 'aprovar'::text])) AND (up.allowed = true)))))
apresentacao_cadencia	apresentacao_cadencia_update	UPDATE	(has_role(auth.uid(), 'admin'::app_role) OR (EXISTS ( SELECT 1
   FROM user_permissions up
  WHERE ((up.user_id = auth.uid()) AND (up.resource = 'apresentacao'::text) AND (up.action = 'gerenciar_templates'::text) AND (up.allowed = true)))))
